{
  "name": "crate-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Designs wooden shipping crates with shape-fitted cradles for machined parts from GLB models.",
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch --disable-warning=ExperimentalWarning server/index.ts\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "engines": { "node": ">=23.6" },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
